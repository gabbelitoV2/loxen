      "file": "various/model/Model.kt",
      "scope": "fun setup",
      "op": "replace",
      "old": "        bluetoothCentralManger = BluetoothAdapter.getDefaultAdapter()",
      "new": "        bluetoothCentralManger = com.moblin.android.platform.corebluetooth.CBCentralManager(delegate = { centralManagerDidUpdateState(it) }, queue = null)",
      "note": "Swift bluetoothCentralManger = CBCentralManager(delegate: self, queue: .main); asks for the Bluetooth permission on first use like iOS."
    },
    {
